# TRACE//FIN — Example Environment Variables
# Copy to .env for local CLI operations (ignored by Git)
# Local AI inference does not require or consume an external provider API key.
DATABASE_URL=""

# Authentication cookie: keep true for HTTPS deployments (also works on localhost).
TRACEFIN_AUTH_COOKIE_SECURE="true"

# MCP browser analysis uses local stdio transport (no public listener, no token).
# Remote page limits are enforced by src/url_fetcher.py: 5 seconds, 3 redirects,
# and 2 MiB of response data. Playwright only renders the safely fetched HTML
# offline with JavaScript and network requests disabled.
